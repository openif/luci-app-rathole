config rathole 'global'
	option enabled '0'
	option mode 'client'
	option binary_path '/usr/bin/rathole'
	option loglevel 'info'
	option logfile '/var/log/rathole.log'

config client 'client'
	option remote_addr ''
	option default_token ''
	option heartbeat_timeout '40'
	option retry_interval '1'
	option noise_enable '0'
	option noise_pattern 'Noise_NK_25519_ChaChaPoly_BLAKE2s'
	option noise_remote_public_key ''

config raw 'raw'
	option content ''

config service 'web'
	option enabled '0'
	option type 'tcp'
	option local_addr '127.0.0.1:80'
	option token ''
	option nodelay '1'

config service 'ssh'
	option enabled '0'
	option type 'tcp'
	option local_addr '127.0.0.1:22'
	option token ''
	option nodelay '1'
