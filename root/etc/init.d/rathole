#!/bin/sh /etc/rc.common
# Copyright (C) 2024-2026 luci-app-rathole contributors
# Licensed under Apache License 2.0

USE_PROCD=1
START=95
STOP=10

EXTRA_COMMANDS="clear_log"
EXTRA_HELP="	clear_log	Clear runtime log file"

CONF="rathole"
CONFIG_DIR="/var/etc/rathole"
CONFIG_FILE="${CONFIG_DIR}/config.toml"

clear_log() {
	config_load "$CONF"
	local logfile
	config_get logfile "global" "logfile" "/var/log/rathole.log"
	: > "$logfile"
	[ -f "/tmp/log/rathole.log" ] && : > "/tmp/log/rathole.log"
	chmod 666 "$logfile" 2>/dev/null
	return 0
}

check_log_size() {
	local logfile="$1"
	if [ -f "$logfile" ]; then
		local size=$(wc -c < "$logfile" 2>/dev/null || echo 0)
		# If log exceeds 2MB (2097152 bytes), keep last 1500 lines using in-place copytruncate
		if [ "$size" -gt 2097152 ]; then
			tail -n 1500 "$logfile" > "${logfile}.tmp" 2>/dev/null && cat "${logfile}.tmp" > "$logfile" && rm -f "${logfile}.tmp"
		fi
	fi
}

append_service() {
	local s="$1"
	local enabled type local_addr token nodelay

	config_get_bool enabled "$s" "enabled" 1
	[ "${enabled:-1}" -eq 1 ] || return 0

	config_get type "$s" "type" "tcp"
	config_get local_addr "$s" "local_addr"
	config_get token "$s" "token"
	config_get_bool nodelay "$s" "nodelay" 1

	[ -z "$local_addr" ] && return 0

	cat <<EOF >> "$CONFIG_FILE"

[client.services."$s"]
type = "$type"
local_addr = "$local_addr"
nodelay = $( [ "${nodelay:-1}" -eq 1 ] && echo "true" || echo "false" )
EOF

	if [ -n "$token" ]; then
		printf 'token = "%s"\n' "$token" >> "$CONFIG_FILE"
	fi
}

generate_config() {
	local mode
	config_get mode "global" "mode" "client"

	mkdir -p "$CONFIG_DIR"

	if [ "$mode" = "raw" ]; then
		local raw_content
		config_get raw_content "raw" "content"
		if [ -z "$raw_content" ]; then
			echo "Rathole error: raw configuration is empty." >&2
			return 1
		fi
		printf "%s\n" "$raw_content" > "$CONFIG_FILE"
		chmod 600 "$CONFIG_FILE"
		return 0
	fi

	# Client mode
	local remote_addr default_token hb_timeout retry_int
	local noise_enable noise_pattern noise_pubkey

	config_get remote_addr "client" "remote_addr"
	config_get default_token "client" "default_token"
	config_get hb_timeout "client" "heartbeat_timeout" "40"
	config_get retry_int "client" "retry_interval" "1"

	config_get_bool noise_enable "client" "noise_enable" 0
	config_get noise_pattern "client" "noise_pattern" "Noise_NK_25519_ChaChaPoly_BLAKE2s"
	config_get noise_pubkey "client" "noise_remote_public_key"

	if [ -z "$remote_addr" ]; then
		echo "Rathole error: remote_addr is required for client mode." >&2
		return 1
	fi

	cat <<EOF > "$CONFIG_FILE"
# Auto-generated by /etc/init.d/rathole. Do not edit directly.
[client]
remote_addr = "$remote_addr"
heartbeat_timeout = $hb_timeout
retry_interval = $retry_int
EOF

	if [ -n "$default_token" ]; then
		printf 'default_token = "%s"\n' "$default_token" >> "$CONFIG_FILE"
	fi

	if [ "${noise_enable:-0}" -eq 1 ] && [ -n "$noise_pubkey" ]; then
		cat <<EOF >> "$CONFIG_FILE"

[client.transport]
type = "noise"

[client.transport.noise]
pattern = "$noise_pattern"
remote_public_key = "$noise_pubkey"
EOF
	fi

	config_foreach append_service "service"
	chmod 600 "$CONFIG_FILE"
	return 0
}

start_service() {
	config_load "$CONF"

	local enabled prog mode logfile loglevel
	config_get_bool enabled "global" "enabled" 0
	[ "${enabled:-0}" -eq 1 ] || return 1

	config_get prog "global" "binary_path" "/usr/bin/rathole"
	if [ ! -x "$prog" ]; then
		echo "Rathole error: binary not found or not executable at $prog" >&2
		return 1
	fi

	config_get mode "global" "mode" "client"
	config_get logfile "global" "logfile" "/var/log/rathole.log"
	config_get loglevel "global" "loglevel" "info"

	generate_config || return 1

	check_log_size "$logfile"
	touch "$logfile"
	chmod 666 "$logfile"

	procd_open_instance "$CONF"
	procd_set_param env RUST_LOG="rathole=$loglevel"

	if [ "$mode" = "client" ]; then
		procd_set_param command /bin/sh -c "exec \"\$@\" >> \"$logfile\" 2>&1" -- "$prog" "--client" "$CONFIG_FILE"
	else
		procd_set_param command /bin/sh -c "exec \"\$@\" >> \"$logfile\" 2>&1" -- "$prog" "$CONFIG_FILE"
	fi

	procd_set_param file "$CONFIG_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0

	procd_close_instance
}

reload_service() {
	config_load "$CONF"
	local enabled prog
	config_get_bool enabled "global" "enabled" 0
	if [ "${enabled:-0}" -ne 1 ]; then
		stop
		return 0
	fi

	config_get prog "global" "binary_path" "/usr/bin/rathole"
	generate_config || return 1

	if ! pgrep -f "$prog" >/dev/null 2>&1; then
		start
	fi
}

stop_service() {
	killall rathole 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	procd_add_interface_trigger "interface.*.up" "wan" /etc/init.d/rathole restart
}
