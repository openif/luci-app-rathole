msgstr "清空日志"

msgid "Are you sure you want to clear the runtime log file?"
msgstr "确定要清空运行日志文件吗？"

msgid "Log file cleared successfully."
msgstr "日志文件已成功清空。"

msgid "Failed to clear log: "
msgstr "清空日志失败："

