msgstr "容器命令行"

msgid "Container Orchestration"
msgstr "容器编排"

msgid "Systemd Daemon"
msgstr "系统守护进程"

msgid "Service name can only contain letters, numbers, hyphens, and underscores."
msgstr "服务名称只能包含英文字母、数字、短横线与下划线。"

msgid "Remote port %s is already assigned to service \"%s\" with same protocol!"
msgstr "远程公网端口 %s 已经被同协议的服务 \"%s\" 占用！"

